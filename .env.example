# Copy to .env and fill in. Never commit .env.

# development | production
DJANGO_ENV=development
# Required when DJANGO_ENV=production
DJANGO_SECRET_KEY=
# Comma-separated hosts (production). On Render the service hostname is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Trusted proxy hops in front of Django (default 1 in production, 0 locally)
# DJANGO_NUM_PROXIES=1
# Set to 0 only when testing the production image over plain HTTP
# DJANGO_SSL_REDIRECT=1

# OpenRouteService key (free): https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Seconds before an upstream provider call is abandoned
PROVIDER_TIMEOUT_SECONDS=10
